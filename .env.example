# скопируй в .env, если запускаешь сервисы руками (без docker compose)

# Go API
API_PORT=8080
DATABASE_URL=postgres://iot:iot@localhost:5432/iot?sslmode=disable
GATEWAY_URL=http://localhost:4000
INGEST_TOKEN=dev-ingest-token
JWT_SECRET=dev-jwt-secret-change-me

# Elixir гейтвей
GATEWAY_PORT=4000
API_URL=http://localhost:8080
# MQTT (по умолчанию выключен)
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPICS=iot/+/telemetry

# Modbus poller (конфиг — JSON-файл, путь через MODBUS_CONFIG)
MODBUS_CONFIG=modbus.json

# Automation (rules engine)
AUTOMATION_CONFIG=automation.json

# Alerts
ALERTS_CONFIG=alerts.json
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
FCM_CREDENTIALS=/secrets/firebase-service-account.json
FCM_TOPIC=iot-alerts

# Local AI (Ollama)
AI_PORT=8095
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
