# скопируй в .env, если запускаешь сервисы руками (без docker compose)

# Go API
API_PORT=8080
DATABASE_URL=postgres://iot:iot@localhost:5432/iot?sslmode=disable
GATEWAY_URL=http://localhost:4000
INGEST_TOKEN=dev-ingest-token
JWT_SECRET=dev-jwt-secret-change-me

# Elixir гейтвей
GATEWAY_PORT=4000
API_URL=http://localhost:8080
# MQTT (по умолчанию выключен)
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPICS=iot/+/telemetry
# Скан подсети (по умолчанию выключен)
DISCOVERY_ENABLED=false
DISCOVERY_SUBNET=192.168.1.0/24
DISCOVERY_INTERVAL_MS=300000

# Modbus poller (конфиг — JSON-файл, путь через MODBUS_CONFIG)
MODBUS_CONFIG=modbus.json

# Automation (rules engine)
AUTOMATION_CONFIG=automation.json

# Alerts
ALERTS_CONFIG=alerts.json
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
FCM_CREDENTIALS=/secrets/firebase-service-account.json
FCM_TOPIC=iot-alerts

# Local AI (Ollama)
AI_PORT=8095
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# EcoPlanner (энергосбережение бассейна)
ECO_PORT=8096
ECO_DEVICE_ID=pool-heater
OWM_API_KEY=
OWM_CITY=Berlin
ECO_BZN=DE-LU
ECO_HEAT_HOURS=4
ECO_INTERVAL=30m

# Grafana (анонимный Viewer, админ-пароль)
GRAFANA_ADMIN_PASSWORD=admin

# HomeKit-мост (HAP)
HOMEBRIDGE_EMAIL=
HOMEBRIDGE_PASSWORD=
HOMEBRIDGE_PIN=00102003
HOMEBRIDGE_STORE=./homekit-store
HOMEBRIDGE_ADDR=:51826
